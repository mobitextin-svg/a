# ─────────────────────────────────────────────────────────────────────────────
#  Real HLR gateway configuration.  Copy to `.env` and fill in, then run:
#     set -a; . ./.env; set +a; python app.py
#  (or export these vars however you prefer).
#
#  The app's HttpProvider is generic: point it at ANY JSON HLR endpoint and map
#  its response fields with the HLR_MAP_* dot-paths. Defaults below target a
#  common "hlr" JSON shape — VERIFY every value against your provider's API docs
#  or account dashboard before trusting results.
# ─────────────────────────────────────────────────────────────────────────────

HLR_PROVIDER=http

# --- Endpoint -------------------------------------------------------------
# The exact URL you POST/GET a lookup to. Get this from your account's API docs.
HLR_API_URL=https://REPLACE-WITH-YOUR-PROVIDER/api/hlr

# The number is sent as this query param. Some APIs want E.164 (+91...), some
# want the raw MSISDN — set HLR_API_E164=1 to send +91E.164.
HLR_API_MSISDN_PARAM=msisdn
HLR_API_E164=1

# --- Authentication -------------------------------------------------------
HLR_API_KEY=REPLACE-WITH-YOUR-API-KEY

# Send the key in a header (default) ...
HLR_API_KEY_HEADER=Authorization
HLR_API_KEY_PREFIX=Bearer
# ... OR set HLR_API_KEY_HEADER= (empty) to send it as a query param instead:
# HLR_API_KEY_HEADER=
# HLR_API_KEY_PARAM=api_key

HLR_API_TIMEOUT=20

# --- Response field mapping (dot-paths into the returned JSON) -------------
# Change the right-hand side to match YOUR provider's response keys.
HLR_MAP_STATUS=hlr.status                 # e.g. CONNECTED / ABSENT / INVALID
HLR_MAP_CURRENT_OP=hlr.currentNetworkName
HLR_MAP_ORIGINAL_OP=hlr.originalNetworkName
HLR_MAP_PORTED=hlr.isPorted
HLR_MAP_ROAMING=hlr.isRoaming
HLR_MAP_MCCMNC=hlr.mccmnc
HLR_MAP_IMSI=hlr.imsi

# --- Throughput (respect your plan's rate limit) --------------------------
HLR_CONCURRENCY=10
HLR_RATE_PER_SEC=8
