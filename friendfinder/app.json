{
  "expo": {
    "name": "BatchMate",
    "slug": "batchmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "batchmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.batchmate.app"
    },
    "android": {
      "package": "com.batchmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
